/**app.wxss**/
/* 粉色主题样式 */
page {
  background-color: #FFF0F5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
  color: #333;
}

/* 主色调 */
.pink-primary {
  color: #FF69B4;
}

.pink-bg {
  background-color: #FFB6C1;
}

.pink-light-bg {
  background-color: #FFF0F5;
}

.pink-gradient {
  background: linear-gradient(135deg, #FFB6C1 0%, #FF69B4 100%);
}

/* 卡片样式 */
.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 105, 180, 0.1);
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #FFB6C1 0%, #FF69B4 100%);
  color: #FFFFFF;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  border: none;
  font-size: 32rpx;
  font-weight: bold;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-secondary {
  background: #FFFFFF;
  color: #FF69B4;
  border: 2rpx solid #FF69B4;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  font-size: 32rpx;
}

/* 输入框样式 */
.input-wrapper {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx;
  margin: 20rpx 0;
  border: 2rpx solid #FFB6C1;
}

.input-wrapper:focus-within {
  border-color: #FF69B4;
  box-shadow: 0 0 0 4rpx rgba(255, 105, 180, 0.1);
}

/* 文本样式 */
.text-primary {
  color: #FF69B4;
}

.text-secondary {
  color: #999;
}

.text-center {
  text-align: center;
}

/* 间距 */
.mt-20 {
  margin-top: 20rpx;
}

.mt-40 {
  margin-top: 40rpx;
}

.mb-20 {
  margin-bottom: 20rpx;
}

.mb-40 {
  margin-bottom: 40rpx;
}

/* 布局 */
.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

