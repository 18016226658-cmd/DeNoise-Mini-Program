<!--pages/history/history.wxml-->
<view class="container">
  <!-- 头部统计 -->
  <view class="card stats-card">
    <view class="stats-title">历史记录统计</view>
    <view class="stats-content">
      <view class="stat-item">
        <text class="stat-value">{{historyCount}}</text>
        <text class="stat-label">总记录数</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{successCount}}</text>
        <text class="stat-label">成功分解</text>
      </view>
    </view>
  </view>

  <!-- 历史记录列表 -->
  <view class="history-list" wx:if="{{historyList.length > 0}}">
    <view class="history-item card" wx:for="{{historyList}}" wx:key="id" bindtap="viewDetail" data-index="{{index}}">
      <view class="history-header">
        <view class="history-number">
          <text class="number-label">原数：</text>
          <text class="number-value">{{item.number}}</text>
        </view>
        <view class="history-time">{{item.time}}</view>
      </view>
      <view class="history-user" wx:if="{{item.user}}">
        <text class="user-label">用户：</text>
        <text class="user-info">
          {{item.user.username}}（{{item.user.gender}}
          <text wx:if="{{item.user.birthYear && item.user.birthMonth}}">
            <text wx:if="{{item.user.birthDay}}">，{{item.user.birthYear}}年{{item.user.birthMonth}}月{{item.user.birthDay}}日</text>
            <text wx:else>，{{item.user.birthYear}}年{{item.user.birthMonth}}月</text>
          </text>
          <text wx:elif="{{item.user.age && item.user.age !== '未知'}}">，{{item.user.age}}岁</text>
          <text wx:if="{{item.user.job}}">，{{item.user.job}}</text>）
        </text>
      </view>
      <view class="history-factors">
        <text class="factors-label">因子：</text>
        <text class="factors-value">{{item.formula || item.factors.join(' × ')}}</text>
      </view>
      <view class="history-footer">
        <text class="factor-count">{{item.factors.length}}个因子</text>
        <text class="elapsed-time">耗时：{{item.elapsedTime}}秒</text>
      </view>
      <view class="history-tags" wx:if="{{item.numberType || item.factorizationLevel}}">
        <text class="tag" wx:if="{{item.numberType}}">{{item.numberType}}</text>
        <text class="tag" wx:if="{{item.factorizationLevel}}">{{item.factorizationLevel}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <text class="empty-icon">📝</text>
    <text class="empty-text">暂无历史记录</text>
    <text class="empty-hint">开始分解大整数，记录会自动保存</text>
  </view>

  <!-- 操作按钮 -->
  <view class="action-bar" wx:if="{{historyList.length > 0}}">
    <button class="btn-secondary" bindtap="clearHistory">清空历史</button>
  </view>
</view>

