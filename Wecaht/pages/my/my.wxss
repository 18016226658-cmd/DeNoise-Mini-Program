/* pages/my/my.wxss */
.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 用户卡片 */
.user-card {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: linear-gradient(135deg, #FFB6C1 0%, #FF69B4 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
  position: relative;
  overflow: hidden;
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 60rpx;
}

.avatar-icon {
  font-size: 60rpx;
}

.avatar-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s;
}

.user-avatar:active .avatar-mask {
  opacity: 1;
}

.avatar-edit {
  font-size: 40rpx;
  color: #FFFFFF;
}

.user-details {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF69B4;
  margin-bottom: 10rpx;
}

.user-desc {
  font-size: 26rpx;
  color: #999;
}

/* 权限卡片 */
.permission-card {
  margin-top: 20rpx;
}

.permission-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF69B4;
  margin-bottom: 20rpx;
}

.permission-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.permission-item:last-child {
  border-bottom: none;
}

.permission-label {
  font-size: 28rpx;
  color: #666;
}

.permission-value {
  font-size: 28rpx;
  color: #FF69B4;
  font-weight: bold;
}

/* 菜单区域 */
.menu-section {
  margin-top: 20rpx;
}

.menu-item {
  margin: 20rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  transition: all 0.3s;
}

.menu-item:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.menu-icon {
  font-size: 50rpx;
  margin-right: 20rpx;
}

.menu-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.menu-title {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.menu-desc {
  font-size: 24rpx;
  color: #999;
}

.menu-arrow {
  font-size: 32rpx;
  color: #CCC;
  margin-left: 20rpx;
}

/* 等级信息卡片 */
.level-info-card {
  margin-top: 20rpx;
}

.level-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF69B4;
  margin-bottom: 20rpx;
}

.level-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.level-item {
  padding: 20rpx;
  background: #FFF0F5;
  border-radius: 10rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.level-name {
  font-size: 28rpx;
  color: #FF69B4;
  font-weight: bold;
}

.level-desc {
  font-size: 24rpx;
  color: #666;
}

