/* pages/home/home.wxss */
.container {
  min-height: 100vh;
  padding-bottom: 20rpx;
  background: #FFF0F5;
}

/* 轮播图 */
.banner-swiper {
  width: 100%;
  height: 360rpx;
  margin-bottom: 20rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

/* 介绍卡片 */
.intro-card {
  margin: 0 20rpx 20rpx 20rpx;
}

.intro-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #FF69B4;
  margin-bottom: 15rpx;
  display: flex;
  align-items: center;
}

.intro-title .icon {
  font-size: 38rpx;
  margin-right: 10rpx;
}

.intro-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
}

/* 功能特性 */
.features {
  margin: 0 20rpx 20rpx 20rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 15rpx;
}

.feature-item {
  width: calc(50% - 7.5rpx);
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 25rpx 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 105, 180, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 0;
}

.feature-icon {
  font-size: 56rpx;
  margin-bottom: 15rpx;
}

.feature-text {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feature-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #FF69B4;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  line-height: 1.4;
}

/* 快速开始 */
.quick-start {
  margin: 0 20rpx 20rpx 20rpx;
  display: flex;
  justify-content: center;
}

.quick-start .btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 34rpx;
  border-radius: 44rpx;
}

/* 用户信息卡片 */
.user-card {
  margin: 0 20rpx 20rpx 20rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.user-level {
  font-size: 30rpx;
  color: #FF69B4;
  font-weight: bold;
}

.user-limit {
  font-size: 26rpx;
  color: #666;
}

