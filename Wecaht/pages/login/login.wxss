/* pages/login/login.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFB6C1 0%, #FFF0F5 100%);
  padding: 60rpx 30rpx;
}

.login-header {
  text-align: center;
  margin-bottom: 80rpx;
}

.app-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 20rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.app-subtitle {
  display: block;
  font-size: 28rpx;
  color: #FFFFFF;
  opacity: 0.9;
}

.login-content {
  width: 100%;
}

.login-card,
.register-card {
  margin-bottom: 40rpx;
}

/* 注册表单优化 */
.register-card .form-item:last-of-type {
  margin-bottom: 20rpx;
}

.form-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF69B4;
  text-align: center;
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 25rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #FFFFFF;
  border: 2rpx solid #FFB6C1;
  border-radius: 20rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  line-height: 88rpx;
}

.form-input:focus {
  border-color: #FF69B4;
  box-shadow: 0 0 0 4rpx rgba(255, 105, 180, 0.1);
}

.picker-view {
  width: 100%;
  height: 88rpx;
  background: #FFFFFF;
  border: 2rpx solid #FFB6C1;
  border-radius: 20rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  line-height: 88rpx;
  min-height: 88rpx;
  position: relative;
}

.picker-view:active {
  border-color: #FF69B4;
  box-shadow: 0 0 0 4rpx rgba(255, 105, 180, 0.1);
}

.picker-text {
  flex: 1;
  color: #333;
}

.picker-arrow {
  color: #999;
  font-size: 36rpx;
  font-weight: bold;
  margin-left: 10rpx;
  line-height: 88rpx;
}

.picker-arrow {
  color: #999;
  font-size: 24rpx;
}

.login-btn,
.register-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 40rpx;
  font-size: 32rpx;
}

.switch-mode {
  text-align: center;
  margin-top: 30rpx;
  font-size: 26rpx;
  color: #999;
}

.link-text {
  color: #FF69B4;
  margin-left: 10rpx;
  font-weight: bold;
}

/* 注册提示 */
.form-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
  line-height: 1.5;
}

.picker-view.disabled {
  background: #F5F5F5;
  color: #999;
  border-color: #E0E0E0;
}

.picker-view.disabled .picker-arrow {
  display: none;
}

.picker-placeholder {
  color: #999;
  flex: 1;
}

/* 记住密码 */
.remember-item {
  margin-top: 20rpx;
  margin-bottom: 0;
}

.remember-label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
}

.remember-text {
  margin-left: 10rpx;
  color: #666;
}

/* 密码输入框包装器 */
.password-input-wrapper {
  position: relative;
  width: 100%;
}

.password-input {
  padding-right: 80rpx !important;
}

.password-toggle {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  pointer-events: auto;
  -webkit-tap-highlight-color: transparent;
}

.password-icon {
  font-size: 40rpx;
  opacity: 0.7;
  transition: opacity 0.3s;
  user-select: none;
  pointer-events: none;
}

.password-toggle:active .password-icon {
  opacity: 1;
  transform: scale(1.1);
}

