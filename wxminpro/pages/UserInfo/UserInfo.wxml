<!--pages/UserInfo/UserInfo.wxml-->
<view class="container">
  <!-- 页面标题 -->
  <view class="header">
    <text class="title">用户信息</text>
    <text class="user-type" wx:if="{{userType === 1}}">管理员</text>
  </view>

  <!-- 当前用户信息 -->
  <view class="section">
    <view class="section-title">
      我的信息
      <text class="edit-btn" bindtap="editCurrentUser">编辑</text>
    </view>
    <view class="info-card">
      <view class="info-item">
        <text class="info-label">手机号：</text>
        <text class="info-value">{{userInfo.Phone || userInfo.user_Phone || '未设置'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">用户名：</text>
        <text class="info-value">{{userInfo.nickName || userInfo.user_name || userInfo.UserName || '未设置'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">性别：</text>
        <text class="info-value">{{userInfo.Gender || userInfo.user_Gender || '未设置'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">生日：</text>
        <text class="info-value">{{userInfo.Birthday || userInfo.user_Birthday || '未设置'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">用户类型：</text>
        <text class="info-value">
          <text wx:if="{{userType === 1}}">管理员</text>
          <text wx:elif="{{userType === 2}}">普通用户</text>
          <text wx:else>游客</text>
        </text>
      </view>
      <view class="info-item">
        <text class="info-label">降噪次数：</text>
        <text class="info-value">
          {{userInfo.CurNoiseTimes || userInfo.user_CurNoiseTimes || 0}} / 
          {{userInfo.MaxNoiseTimes || userInfo.user_MaxNoiseTimes || 0}}
        </text>
      </view>
      <view class="info-item">
        <text class="info-label">分离次数：</text>
        <text class="info-value">
          {{userInfo.CurSepTimes || userInfo.user_CurSepTimes || 0}} / 
          {{userInfo.MaxSepTimes || userInfo.user_MaxSepTimes || 0}}
        </text>
      </view>

      <!-- 退出账号按钮 -->
      <view class="logout-section">
        <button class="logout-btn" bindtap="logout">退出账号</button>
      </view>
    </view>
  </view>

  <!-- 管理员功能 -->
  <view class="section" wx:if="{{userType === 1}}">
    <view class="section-title">所有用户 ({{userList.length}})</view>
    <view class="user-list" wx:if="{{userList.length > 0}}">
      <view class="user-item" wx:for="{{userList}}" wx:key="Phone">
        <view class="user-avatar">
          <image src="{{item.FaceImg || '/static/image/header.png'}}" mode="aspectFill"></image>
        </view>
        <view class="user-details">
          <text class="user-name">{{item.UserName || '未设置'}}</text>
          <text class="user-phone">{{item.Phone}}</text>
          <text class="user-type-badge" wx:if="{{item.UserType === 1}}">管理员</text>
          <text class="user-type-badge normal" wx:elif="{{item.UserType === 2}}">普通用户</text>
          <text class="user-type-badge guest" wx:else>游客</text>
        </view>
        <view class="user-actions">
          <text class="edit-user-btn" bindtap="editUser" data-phone="{{item.Phone}}">编辑</text>
        </view>
        <view class="user-stats">
          <text class="stat-text">降噪: {{item.CurNoiseTimes || 0}}/{{item.MaxNoiseTimes || 0}}</text>
          <text class="stat-text">分离: {{item.CurSepTimes || 0}}/{{item.MaxSepTimes || 0}}</text>
        </view>
      </view>
    </view>
    <view class="empty-tip" wx:else>
      <text>暂无用户数据</text>
    </view>
  </view>
</view>


