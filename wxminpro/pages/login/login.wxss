/* pages/login/login.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #6A5ACD 0%, #9370DB 100%);
  padding: 60rpx 30rpx;
}

.login-header {
  text-align: center;
  margin-bottom: 80rpx;
}

.app-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 20rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.app-subtitle {
  display: block;
  font-size: 28rpx;
  color: #FFFFFF;
  opacity: 0.9;
}

.login-content {
  width: 100%;
}

.card {
  background: #FFFFFF;
  border-radius: 30rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.1);
}

.form-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #6A5ACD;
  text-align: center;
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #F8F8F8;
  border: 2rpx solid #E0E0E0;
  border-radius: 20rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  line-height: 88rpx;
}

.form-input:focus {
  border-color: #6A5ACD;
  background: #FFFFFF;
}

.password-input-wrapper {
  position: relative;
  width: 100%;
}

.password-input {
  padding-right: 80rpx !important;
}

.password-toggle {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.password-icon {
  font-size: 40rpx;
  opacity: 0.6;
}

.remember-item {
  margin-top: 20rpx;
  margin-bottom: 10rpx;
}

.remember-label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
}

.remember-text {
  margin-left: 10rpx;
  color: #666;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 40rpx;
  font-size: 32rpx;
  background: linear-gradient(90deg, #6A5ACD 0%, #9370DB 100%);
  color: #FFFFFF;
  border-radius: 20rpx;
  border: none;
}

.btn-primary[disabled] {
  background: #E0E0E0;
  color: #999;
}

.btn-secondary {
  width: 200rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 26rpx;
  background: #F0F0F0;
  color: #666;
  border-radius: 10rpx;
  border: none;
}

.switch-mode {
  text-align: center;
  margin-top: 30rpx;
  font-size: 26rpx;
  color: #999;
}

.link-text {
  color: #6A5ACD;
  margin-left: 10rpx;
  font-weight: bold;
}

