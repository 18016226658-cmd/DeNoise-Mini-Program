<!--pages/login/login.wxml-->
<view class="container">
  <view class="login-header">
    <text class="app-title">音频降噪系统</text>
    <text class="app-subtitle">欢迎使用</text>
  </view>

  <view class="login-content">
    <!-- 登录表单 -->
    <view class="card login-card" wx:if="{{!showRegister}}">
      <view class="form-title">登录</view>
      
      <view class="form-item">
        <view class="form-label">手机号</view>
        <input 
          class="form-input" 
          type="number" 
          placeholder="请输入手机号"
          value="{{Phone}}"
          maxlength="11"
          bindinput="onPhoneInput"
        />
      </view>

      <view class="form-item">
        <view class="form-label">密码</view>
        <view class="password-input-wrapper">
          <input 
            class="form-input password-input" 
            type="text"
            password="{{!showPassword}}"
            placeholder="请输入密码"
            value="{{Password}}"
            bindinput="onPasswordInput"
          />
          <view class="password-toggle" catchtap="togglePassword">
            <text class="password-icon">{{showPassword ? '👁️' : '👁️‍🗨️'}}</text>
          </view>
        </view>
      </view>

      <view class="form-item remember-item">
        <checkbox-group bindchange="onRememberPasswordChange">
          <label class="remember-label">
            <checkbox value="remember" checked="{{rememberPassword}}" color="#FF69B4"/>
            <text class="remember-text">记住密码</text>
          </label>
        </checkbox-group>
      </view>

      <button class="btn-primary login-btn" disabled="{{jin}}" bindtap="handleLogin">登录</button>
      
      <view class="switch-mode">
        <text>还没有账号？</text>
        <text class="link-text" bindtap="switchToRegister">立即注册</text>
      </view>
    </view>

    <!-- 注册表单 -->
    <view class="card register-card" wx:else>
      <view class="form-title">注册</view>
      
      <view class="form-item">
        <view class="form-label">手机号</view>
        <input 
          class="form-input" 
          type="number" 
          placeholder="请输入手机号（11位）"
          value="{{registerPhone}}"
          maxlength="11"
          bindinput="onRegisterPhoneInput"
        />
      </view>

      <view class="form-item">
        <view class="form-label">用户名</view>
        <input 
          class="form-input" 
          type="text" 
          placeholder="请输入用户名"
          value="{{registerUserName}}"
          bindinput="onRegisterUserNameInput"
        />
      </view>

      <view class="form-item">
        <view class="form-label">性别</view>
        <input 
          class="form-input" 
          type="text" 
          placeholder="请输入（男/女）"
          value="{{registerGender}}"
          bindinput="onRegisterGenderInput"
        />
      </view>

      <view class="form-item">
        <view class="form-label">出生日期</view>
        <input 
          class="form-input" 
          type="text" 
          placeholder="请输入（YYYY-MM-DD）"
          value="{{registerBirthday}}"
          bindinput="onRegisterBirthdayInput"
        />
      </view>

      <view class="form-item">
        <view class="form-label">密码</view>
        <view class="password-input-wrapper">
          <input 
            class="form-input password-input" 
            type="text"
            password="{{!showRegisterPassword}}"
            placeholder="请输入密码（至少6位）"
            value="{{registerPassword}}"
            bindinput="onRegisterPasswordInput"
          />
          <view class="password-toggle" catchtap="toggleRegisterPassword">
            <text class="password-icon">{{showRegisterPassword ? '👁️' : '👁️‍🗨️'}}</text>
          </view>
        </view>
      </view>

      <view class="form-item">
        <view class="form-label">确认密码</view>
        <view class="password-input-wrapper">
          <input 
            class="form-input password-input" 
            type="text"
            password="{{!showRegisterPasswordConfirm}}"
            placeholder="请再次输入密码"
            value="{{registerPasswordConfirm}}"
            bindinput="onRegisterPasswordConfirmInput"
          />
          <view class="password-toggle" catchtap="toggleRegisterPasswordConfirm">
            <text class="password-icon">{{showRegisterPasswordConfirm ? '👁️' : '👁️‍🗨️'}}</text>
          </view>
        </view>
      </view>

      <view class="form-item">
        <view class="form-label">头像</view>
        <button class="btn-secondary" bindtap="selectFaceImg">选择头像</button>
        <image wx:if="{{Path}}" src="{{Path}}" style="width: 100rpx; height: 100rpx; margin-top: 20rpx; border-radius: 50%;"></image>
      </view>

      <button class="btn-primary register-btn" disabled="{{jin}}" bindtap="handleRegister">注册</button>
      
      <view class="switch-mode">
        <text>已有账号？</text>
        <text class="link-text" bindtap="switchToLogin">立即登录</text>
      </view>
    </view>
  </view>
</view>

