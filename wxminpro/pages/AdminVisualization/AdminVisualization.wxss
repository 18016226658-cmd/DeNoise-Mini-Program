/* pages/AdminVisualization/AdminVisualization.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 顶部渐变标题，与历史记录页保持一致风格 */
.header {
  text-align: center;
  padding: 30rpx 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  margin-bottom: 30rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #ffffff;
  opacity: 0.9;
}

/* 主体白色内容卡片 */
.content {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
}

/* 图表选择按钮区域：两列宫格 */
.chart-selector {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-column-gap: 20rpx;
  grid-row-gap: 20rpx;
  margin-bottom: 30rpx;
}

.chart-btn {
  background: #f8f8ff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  text-align: left;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #e0e0ff;
}

.chart-btn-active {
  background: linear-gradient(135deg, #667eea 0%, #44adfb 100%);
  border-color: transparent;
}

.chart-btn-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.chart-btn-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999999;
}

.chart-btn-active .chart-btn-title,
.chart-btn-active .chart-btn-desc {
  color: #ffffff;
}

.chart-btn::after {
  border: none;
}

/* 图表卡片区域，与历史记录里的卡片风格呼应 */
.chart-section {
  background-color: #f9f9f9;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e0e0e0;
}

.chart-section-header {
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #e0e0e0;
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.chart-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.chart-hint {
  font-size: 22rpx;
  color: #999999;
  font-style: italic;
}

.chart-canvas {
  width: 100%;
  height: 500rpx;
}

.chart-image {
  width: 100%;
  min-height: 400rpx;
  max-height: 600rpx;
  border-radius: 8rpx;
  background-color: #ffffff;
  cursor: pointer;
}

/* 生成图表按钮容器 */
.generate-btn-container {
  margin-bottom: 30rpx;
  display: flex;
  justify-content: center;
}

.generate-btn {
  background: linear-gradient(135deg, #667eea 0%, #44adfb 100%);
  color: #ffffff;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
  border: none;
}

.generate-btn::after {
  border: none;
}

.generate-btn-text {
  color: #ffffff;
}

