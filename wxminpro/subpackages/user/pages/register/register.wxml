<!--pages/register/register.wxml-->

<view class="box">
 
 <view class="title">
   <text bindtap="Login" class="denglu" style="font-size: x-large ;" >登录</text>
   <text bindtap="Register" class="zhuce" style="font-size: x-large ; color: pink;font-weight: bolder;background-color: rgb(6, 12, 1);">注册</text>
 </view>

 <view class="register">
    <text class="AA">手机号:</text>
    <input type="number" bindinput="PhoneInput" maxlength="11" placeholder="输入手机号" value="{{Phone}}" style="background:#A1A1A1;  display:inline-block"></input>
 </view>
 <view class="register" style="display: flex; flex-direction: row; align-items: center;">
    <text class="AA">验证码:</text>
    <input type="number" bindinput="CodeInput" maxlength="6" placeholder="输入6位验证码" value="{{Code}}" style="background:#A1A1A1; flex: 1; margin-right: 10rpx;"></input>
    <button class="get-code-btn" bindtap="getCode" disabled="{{codeCountdown > 0}}" style="padding: 10rpx 20rpx; font-size: 24rpx; white-space: nowrap;">
      {{codeCountdown > 0 ? codeCountdown + 's' : '获取验证码'}}
    </button>
 </view>
 <view class="register">
    <text class="AA">用户名:</text>
     <input type="text" bindinput="UsernameInput" placeholder="输入用户昵称" style="background:#A1A1A1;  display:inline-table"></input>
</view>
<view class="register">
     <text class="AA">性    别:</text>
     <input type="text" bindinput="GenderInput" placeholder="输入（男/女）" style="background:#A1A1A1; display: inline-block; "> </input>  
 </view>
 <view class="register">
     <text class="AA">出生年月:</text>
     <input type="text" bindinput="BirthdayInput" placeholder="YYYY-MM-DD" style="background:#A1A1A1;  display: inline-block;"></input>
 </view>
 <view class="register">
     <text class="AA">密码:</text>
     <input type="password" bindinput="PasswordInput" placeholder="设置密码" style="background:#A1A1A1;  display: inline-block;"></input>
 </view>
 <view class="register">
     <!-- <text class="AA">头像:</text> -->
     <!-- <button bind:tap="FaceImgInput" style="color: #d81313; display: inline-block;">选择头像文件</button>  -->
     <button bind:tap="SelectImgFile" style="color: #d81313; display: inline-block;">选择头像文件</button>  
     <image src="{{Path}}"  style="height: 100rpx;width: 100rpx;" ></image>
</view>

<!-- <view class="register">
     <button bind:tap="UploadImgFile" style="color: #d81313; display: inline-block;">上传头像文件</button>  
</view> -->
 


 <view>
     <button disabled="{{jin}}" bindtap="Post" style="font-size: x-large ; font-weight: bold;">点击注册</button>
     <view>{{ RegisterAnswer  }}   </view>
 </view>


</view> 
