/* pages/UserInfo/UserInfo.wxss */
.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.user-type {
  font-size: 24rpx;
  color: #6A5ACD;
  background-color: #e8e4ff;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #666;
  margin-bottom: 20rpx;
}

.info-card {
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.info-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
  width: 180rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.action-card {
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 20rpx;
}

.action-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.action-text {
  font-size: 30rpx;
  color: #333;
  flex: 1;
}

.action-arrow {
  font-size: 36rpx;
  color: #999;
}

.user-list {
  background-color: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.user-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.user-item:last-child {
  border-bottom: none;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.user-avatar image {
  width: 100%;
  height: 100%;
}

.user-details {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.user-phone {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.user-type-badge {
  display: inline-block;
  font-size: 20rpx;
  color: #6A5ACD;
  background-color: #e8e4ff;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  width: fit-content;
}

.user-type-badge.normal {
  color: #44ADFB;
  background-color: #e0f4ff;
}

.user-type-badge.guest {
  color: #999;
  background-color: #f0f0f0;
}

.user-stats {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.stat-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 5rpx;
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

