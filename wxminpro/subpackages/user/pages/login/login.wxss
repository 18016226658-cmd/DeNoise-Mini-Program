/* pages/login/login.wxss */
page{
  height: 100%;
  background-color: white;
  margin: 0px;
  padding: 0px;
}

.top-box{
  height: 30%;
  background-image: linear-gradient( #44ADFB,#5ed6fd);
  padding: 30rpx;
  color: white;
  font-weight: bold;
}
.next-text{
  margin-top: 15rpx;
}

.center-box{
  background-color: white;
  margin: -20% 20rpx 0rpx 20rpx;
  padding: 25rpx;
  border-radius: 15rpx;
  -WEBkit-filter: drop-shadow(0 0 8rpx #44ADFB);
  filter: drop-shadow(0 0 8rpx #44ADFB);
}

.nav{
  display: flex;
  text-align: center;
  font-size: 32rpx;
  margin-bottom: 8%;
}
.left{
  flex: 1;
  font-weight: bold;
}
.right{
  flex: 1;
  font-weight: bold;
}
.select{
  font-weight: bold;
  color: #33ccff;
}
.select text{
  padding-bottom: 5rpx;
  border-bottom-left-radius: 10rpx;
  border-bottom-right-radius: 10rpx;
  border-bottom: 5rpx solid #33ccff;
}
.wei-input{
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 40rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f1f1f1;
}
.input-box{
  margin: 20rpx;
}
.input{
  padding-left: 20rpx;
  font-size: 30rpx;
}
.input-code{
  position: absolute;
  right: 40rpx;
  font-size: 26rpx;
  padding: 10rpx 15rpx;
  color: white;
  background-color: #FF8C69;
  border-radius: 10rpx;
}
.forget{
  font-size: 26rpx;
  color: #33ccff;
  margin-top: 20rpx;
  text-align: right;
}
.sumbit-btn{
  margin: 6% 30rpx 30rpx 30rpx;
}

.shadow{
  box-shadow: 0rpx 0rpx 10rpx 0rpx #44ADFB;
  border-radius: 25rpx;
  background-color: white;
}
.shadow-1{
  height: 40rpx;
  margin: -20rpx 50rpx 0 50rpx;
}
.shadow-2{
  position: relative;
  z-index: -888;
  height: 50rpx;
  margin: -30rpx 80rpx 0 80rpx;
}

.bottom-box{
  position:fixed; 
  bottom: 10rpx;
  width:100%;
  font-size: 24rpx;
  color: gray;
  display: flex;
  justify-content: center;
}

.longin{
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 40rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f1f1f1;

}

.box{
  position:absolute;
  left: 35px;
  top: 50px;
  width: 250px;
  height: 250px;
}
.title text{
  margin-left: 60px;
}
input{
  margin-top: 40px;
}
button{
  margin-top: 40px;
  background-color: pink;
}

/* 登录方式切换 */
.login-type-switch {
  display: flex;
  flex-direction: row;
  margin: 30rpx 0;
  border-bottom: 1rpx solid #f1f1f1;
}

.switch-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
}

.switch-item.active {
  color: #44ADFB;
  border-bottom: 3rpx solid #44ADFB;
}

/* 验证码输入框样式 */
.code-input {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.get-code-btn {
  margin-left: 20rpx;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  background-color: #44ADFB;
  color: white;
  border-radius: 8rpx;
  border: none;
  min-width: 140rpx;
}

.get-code-btn[disabled] {
  background-color: #ccc;
  color: #999;
}