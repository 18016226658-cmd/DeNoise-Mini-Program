/* pages/soundRecord/soundRecord.wxss */

.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 头部区域 */
.header {
  text-align: center;
  padding: 40rpx 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.3);
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #ffffff;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #ffffff;
  opacity: 0.9;
}

/* 通用卡片区域 */
.section {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 录音区域 */
.record-section {
  text-align: center;
}

.record-status {
  margin-bottom: 40rpx;
}

.record-status.recording {
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.6;
  }
}

.status-text {
  font-size: 28rpx;
  color: #666666;
}

.recording-text {
  color: #e74c3c;
  font-weight: bold;
}

/* 录音按钮 */
.record-button-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 40rpx 0;
  position: relative;
}

.record-button {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 8rpx 30rpx rgba(102, 126, 234, 0.4);
  position: relative;
  transition: all 0.3s;
}

.record-button.recording {
  background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
  animation: recordPulse 1.5s ease-in-out infinite;
  box-shadow: 0 8rpx 30rpx rgba(231, 76, 60, 0.5);
}

@keyframes recordPulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.1);
  }
}

.record-button-inner {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  justify-content: center;
  align-items: center;
  backdrop-filter: blur(10rpx);
}

.record-icon {
  font-size: 80rpx;
  color: #ffffff;
}

/* 录音波纹效果 */
.record-ripple {
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(231, 76, 60, 0.6);
  animation: ripple 1.5s ease-out infinite;
}

@keyframes ripple {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  100% {
    transform: scale(1.5);
    opacity: 0;
  }
}

/* 时间显示 */
.time-display {
  margin: 30rpx 0;
}

.time-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  font-family: 'Courier New', monospace;
}

/* 进度条 */
.progress-section {
  margin: 30rpx 0;
}

.progress-bar {
  width: 100%;
  height: 8rpx;
  background-color: #e0e0e0;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 4rpx;
  transition: width 0.3s;
}

/* 播放控制 */
.play-controls {
  margin-top: 30rpx;
  display: flex;
  justify-content: center;
}

.play-btn {
  padding: 20rpx 50rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  border-radius: 50rpx;
  border: none;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 4rpx 15rpx rgba(102, 126, 234, 0.3);
}

.play-btn::after {
  border: none;
}

.play-icon {
  font-size: 32rpx;
}

/* 文本区域 */
.text-section,
.chat-section {
  margin-top: 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 25rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.section-icon {
  font-size: 36rpx;
  margin-right: 15rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  flex: 1;
}

.action-icon-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
  border: none;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0;
  box-shadow: 0 2rpx 10rpx rgba(17, 153, 142, 0.3);
}

.action-icon-btn::after {
  border: none;
}

.action-icon-btn .icon {
  font-size: 28rpx;
  color: #ffffff;
}

.text-content {
  min-height: 120rpx;
  padding: 25rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 15rpx;
  border-left: 4rpx solid #667eea;
}

.text-placeholder {
  font-size: 26rpx;
  color: #999999;
  font-style: italic;
}

.text-result {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.8;
  word-break: break-all;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.empty-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}
