/* pages/AudioSep/AudioSep.wxss */

.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 头部区域 */
.header {
  text-align: center;
  padding: 40rpx 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.3);
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #ffffff;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #ffffff;
  opacity: 0.9;
}

/* 通用卡片区域 */
.section {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 文件选择按钮 */
.select-btn {
  width: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  font-size: 32rpx;
  padding: 25rpx 0;
  border-radius: 15rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 15rpx rgba(102, 126, 234, 0.3);
}

.select-btn::after {
  border: none;
}

.btn-icon {
  font-size: 36rpx;
  margin-right: 10rpx;
}

/* 文件信息 */
.file-info {
  margin-top: 20rpx;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 10rpx;
  border-left: 4rpx solid #667eea;
}

.file-name {
  font-size: 28rpx;
  color: #333333;
  word-break: break-all;
}

/* 信息标题 */
.info-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 25rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #667eea;
}

/* 信息网格 */
.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.info-item {
  padding: 20rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
}

.info-item.highlight {
  background: linear-gradient(135deg, #ffeaa7 0%, #fdcb6e 100%);
  grid-column: 1 / -1;
}

.info-label {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.info-value.count {
  font-size: 36rpx;
  color: #e74c3c;
}

/* 音频区域标题 */
.audio-section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.section-icon {
  font-size: 36rpx;
  margin-right: 10rpx;
}

/* 音频播放器容器 */
.audio-player-wrapper {
  display: flex;
  align-items: center;
  gap: 15rpx;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
}

.audio-player {
  flex: 1;
  height: 80rpx;
}

/* 控制按钮 */
.control-btn {
  padding: 15rpx 25rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  border-radius: 10rpx;
  border: none;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.3);
}

.control-btn::after {
  border: none;
}

.control-btn.small {
  padding: 12rpx 20rpx;
  font-size: 22rpx;
}

.control-btn.download {
  background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
}

.control-btn[disabled] {
  opacity: 0.5;
  background: #cccccc;
}

.icon {
  width: 32rpx;
  height: 32rpx;
}

/* 操作按钮组 */
.action-buttons {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  padding: 25rpx 0;
  border-radius: 15rpx;
  border: none;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.1);
}

.action-btn::after {
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
}

.action-btn.secondary {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: #ffffff;
}

.action-btn[disabled] {
  opacity: 0.5;
  background: #cccccc;
  color: #666666;
}

/* 轨道卡片 */
.track-card {
  margin-bottom: 25rpx;
  padding: 25rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 15rpx;
  border-left: 6rpx solid #667eea;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.track-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #e0e0e0;
}

.track-icon {
  font-size: 40rpx;
  margin-right: 15rpx;
}

.track-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.track-controls {
  display: flex;
  gap: 10rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.empty-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}
